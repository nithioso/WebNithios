---
/**
 * /servicios/ — índice de las dos líneas de servicio.
 * Contenido: services.ts (servicios) + service-details.ts (servicesHub) + faqs.ts (selección).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { pageOgImage } from '@/lib/images';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Card from '@/components/Card.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Button from '@/components/Button.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import Reveal from '@/components/Reveal.astro';
import ServiceHeroArt from '@/components/ServiceHeroArt.astro';
import { cities, coverage } from '@/data/site';
import { services, getService } from '@/data/services';
import { sortedProjects } from '@/data/projects';
import { faqs } from '@/data/faqs';
import { servicesHub as hub, getServiceDetail } from '@/data/service-details';
import { allServices, itemList, type Crumb } from '@/lib/schema';

const path = '/servicios/';
const crumbs: Crumb[] = [{ name: 'Servicios', path }];

const hubFaqs = hub.faqQuestions
  .map((q) => faqs.find((f) => f.question === q))
  .filter((f): f is NonNullable<typeof f> => Boolean(f));

const featuredProjects = sortedProjects.filter((p) => p.featured);

const jsonLd = [
  ...allServices(),
  itemList(
    services.map((s) => ({ name: s.name, path: s.path })),
    'Servicios de Nithios',
  ),
  // FAQPage solo en /preguntas-frecuentes/ (estas preguntas salen de faqs.ts): aquí el acordeón es solo visible.
];

// Imagen Open Graph propia (src/data/og.ts · npm run og).
const og = await pageOgImage('/servicios/');
---

<BaseLayout
  title={hub.seoTitle}
  description={hub.seoDescription}
  path={path}
  ogImage={og.src}
  ogImageAlt={og.alt}
  breadcrumbs={crumbs}
  pageType="CollectionPage"
  jsonLd={jsonLd}
  whatsappMessage={hub.whatsappMessage}
>
  <PageHero
    eyebrow={hub.heroEyebrow}
    title={hub.heroTitle}
    titleHtml={hub.heroTitleHtml}
    intro={hub.intro}
    breadcrumbs={crumbs}
    whatsappMessage={hub.whatsappMessage}
    secondary={{ label: 'Ver portafolio', href: '/portafolio/' }}
  >
    <ServiceHeroArt
      slot="aside"
      items={services.map((sv) => ({
        icon: sv.icon,
        title: sv.shortName,
        points: (getServiceDetail(sv.slug)?.deliverables ?? []).map((x) => x.title),
      }))}
    />
  </PageHero>

  <!-- Las dos líneas de servicio -->
  <Section id="lineas" eyebrow="Dos líneas, un objetivo" title={hub.overview.question} spacing="md">
    <Reveal>
      <p class="max-w-3xl text-xl leading-snug font-medium tracking-[-0.015em] text-pearl md:text-2xl">
        {hub.overview.answer}
      </p>
    </Reveal>
    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      {
        services.map((s, i) => (
          <Card
            tone={i === 0 ? 'gold' : 'glass'}
            size="lg"
            icon={s.icon}
            eyebrow={s.shortName}
            title={s.name}
            text={s.summary}
            href={s.path}
            headingLevel="h3"
            revealDelay={i * 120}
          >
            <p class="mt-5 text-lg font-medium text-pearl">{s.headline}</p>
            <ul class="mt-6 grid gap-2.5 sm:grid-cols-2">
              {s.capabilities.map((c) => (
                <li class="flex items-start gap-2.5 text-sm text-mist">
                  <Icon name="check" size={16} class="mt-0.5 shrink-0 text-gold-400" />
                  <span>{c.title}</span>
                </li>
              ))}
            </ul>
            <Fragment slot="footer">
              <span class="inline-flex items-center gap-1.5 text-sm font-medium text-gold-300" aria-hidden="true">
                Conocer {s.shortName.toLowerCase()}
                <Icon name="arrow-right" size={16} class="transition-transform duration-300 group-hover:translate-x-1" />
              </span>
            </Fragment>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- ¿Cuál necesitas? -->
  <Section
    id="cual-necesitas"
    eyebrow="Guía rápida"
    title="¿Consultoría o desarrollo? Elige en un minuto."
    intro="No necesitas saberlo todo para empezar. Estas señales te ayudan a identificar el punto de partida; si dudas, escríbenos y lo definimos juntos."
    tone="raised"
  >
    <div class="grid gap-6 md:grid-cols-2">
      {
        hub.chooser.map((c, i) => {
          const s = getService(c.slug);
          return (
            <Reveal delay={i * 120} class="flex flex-col rounded-(--radius-card) hairline bg-ink-900 p-8 md:p-10">
              <h3 class="text-display-sm font-semibold">{c.title}</h3>
              <ul class="mt-7 space-y-4">
                {c.points.map((pt) => (
                  <li class="flex items-start gap-3 leading-relaxed text-mist">
                    <Icon name="check-circle" size={22} class="mt-0.5 shrink-0 text-gold-400" />
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
              {s && (
                <div class="mt-auto pt-8">
                  <Button href={s.path} variant="glass" iconRight="arrow-right">
                    {s.shortName}
                  </Button>
                </div>
              )}
            </Reveal>
          );
        })
      }
    </div>
  </Section>

  <!-- Camino completo -->
  <Section
    id="camino"
    eyebrow="De la estrategia al código"
    title="Un solo equipo, de principio a fin."
    intro={hub.journeyText}
    tone="glow"
  >
    <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        hub.journey.map((step, i) => (
          <Reveal as="li" delay={i * 90} class="relative rounded-(--radius-card) glass p-7">
            <span class="inline-flex size-12 items-center justify-center rounded-2xl border border-line-gold bg-gold-500/8 text-gold-300">
              <Icon name={step.icon} size={24} />
            </span>
            <p class="mt-6 text-sm font-medium text-smoke" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-1 text-xl font-semibold tracking-[-0.02em] text-pearl">
              <span class="sr-only">Etapa {i + 1}: </span>
              {step.title}
            </h3>
            <p class="mt-3 leading-relaxed text-mist">{step.text}</p>
          </Reveal>
        ))
      }
    </ol>
    <Reveal class="mt-12 max-w-3xl">
      <p class="leading-relaxed text-mist">
        Detrás de ambos servicios está <a href="/jonathan-osorio/" class="link-inline">Jonathan Osorio, CEO y Fundador de Nithios</a>, un alto ejecutivo de tecnología con casi 20 años de experiencia en diferentes sectores y una amplia formación académica.
      </p>
    </Reveal>
  </Section>

  <!-- Portafolio -->
  {
    featuredProjects.length > 0 && (
      <Section
        id="casos"
        eyebrow="Portafolio"
        title="Software que diseñamos y desarrollamos."
        intro="Ejemplos de plataformas que Nithios ha diseñado y desarrollado: comercio internacional y atención psicológica remota."
        tone="raised"
      >
        <div class="grid gap-6 md:grid-cols-2">
          {featuredProjects.map((p, i) => (
            <ProjectCard project={p} revealDelay={i * 100} />
          ))}
        </div>
        <Fragment slot="actions">
          <Button href="/portafolio/" variant="glass" iconRight="arrow-right">
            Ver todo el portafolio
          </Button>
        </Fragment>
      </Section>
    )
  }

  <!-- Cobertura -->
  <Section id="cobertura" eyebrow="Cobertura" title="Servicios de tecnología en toda Colombia" spacing="md">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <Reveal class="lg:col-span-7">
        <p class="text-lead text-mist">
          {coverage.long} Si buscas consultoría tecnológica o una empresa de desarrollo de software en Bogotá, Medellín o cualquier otra ciudad, trabajamos contigo en línea, con reuniones, revisiones y entregas digitales.
        </p>
      </Reveal>
      <Reveal class="lg:col-span-5" delay={120}>
        <ul class="flex flex-wrap gap-2.5" aria-label="Ciudades donde atendemos de forma remota">
          {
            cities.map((c) => (
              <li class="inline-flex items-center gap-2 rounded-full border border-line bg-ink-850 px-4 py-2 text-sm text-pearl">
                <Icon name="map-pin" size={15} class="text-gold-400" />
                {c}
              </li>
            ))
          }
        </ul>
      </Reveal>
    </div>
  </Section>

  <!-- FAQ -->
  {
    hubFaqs.length > 0 && (
      <Section id="preguntas" eyebrow="Preguntas frecuentes" title="Lo que suelen preguntarnos" tone="raised" width="narrow">
        <FaqList items={hubFaqs} openFirst />
        <Fragment slot="actions">
          <Button href="/preguntas-frecuentes/" variant="link" iconRight="arrow-right">
            Ver todas las preguntas
          </Button>
        </Fragment>
      </Section>
    )
  }

  <CtaBand
    title={hub.cta.title}
    text={hub.cta.text}
    message={hub.whatsappMessage}
    secondary={{ label: 'Ver portafolio', href: '/portafolio/' }}
  />
</BaseLayout>
