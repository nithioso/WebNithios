---
/**
 * /contacto/ — página de conversión. Contenido: src/data/contact.ts.
 * El formulario (ContactForm) no envía datos a ningún servidor: compone el mensaje y abre WhatsApp.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { pageOgImage } from '@/lib/images';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Card from '@/components/Card.astro';
import ContactForm from '@/components/ContactForm.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import Reveal from '@/components/Reveal.astro';
import { site, cities, waLink } from '@/data/site';
import { services } from '@/data/services';
import { contactPage as c } from '@/data/contact';
import { ids, type Crumb } from '@/lib/schema';
import type { IconName } from '@/lib/icons';

const path = c.path;
const crumbs: Crumb[] = [{ name: 'Contacto', path }];
const stepIcons: IconName[] = ['whatsapp', 'message', 'target', 'clipboard'];

// Imagen Open Graph propia (src/data/og.ts · npm run og).
const og = await pageOgImage('/contacto/');
---

<BaseLayout
  title={c.seoTitle}
  description={c.seoDescription}
  path={path}
  ogImage={og.src}
  ogImageAlt={og.alt}
  breadcrumbs={crumbs}
  pageType="ContactPage"
  mainEntityId={ids.organization}
  whatsappMessage={c.whatsappMessage}
>
  <PageHero
    eyebrow={c.heroEyebrow}
    title={c.heroTitle}
    titleHtml={c.heroTitleHtml}
    intro={c.intro}
    breadcrumbs={crumbs}
    whatsappMessage={c.whatsappMessage}
    secondary={{ label: 'Ver servicios', href: '/servicios/' }}
    size="md"
    align="center"
  >
    <p class="mt-8 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm text-smoke" data-reveal style="--reveal-delay:300ms">
      <Icon name="whatsapp" size={18} class="text-gold-400" />
      <span>WhatsApp</span>
      <a href={waLink(c.whatsappMessage)} target="_blank" rel="noopener noreferrer" data-wa-location="contacto-canal" class="link-underline text-base font-medium text-pearl">
        {site.whatsapp.display}
      </a>
    </p>
  </PageHero>

  <!-- Formulario + respuesta directa -->
  <section id="formulario" class="relative pb-24 md:pb-32" aria-labelledby="formulario-titulo">
    <div class="container-x grid gap-10 lg:grid-cols-12 lg:gap-14">
      <ContactForm class="lg:col-span-7" />

      <div class="flex flex-col gap-6 lg:col-span-5">
        <Reveal class="glass rounded-(--radius-card) p-7 md:p-8">
          <h2 class="text-xl font-semibold tracking-[-0.015em] md:text-2xl">{c.answerTitle}</h2>
          <p class="mt-4 leading-relaxed text-mist">{c.answer}</p>
        </Reveal>

        <Reveal class="hairline rounded-(--radius-card) p-7 md:p-8" delay={100}>
          <h2 class="text-xl font-semibold tracking-[-0.015em]">¿En qué te podemos ayudar?</h2>
          <ul class="mt-5 grid gap-3" role="list">
            {
              services.map((s) => (
                <li>
                  <a
                    href={s.path}
                    class="group flex min-h-11 items-start gap-3 rounded-2xl p-2 -m-2 transition-colors hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-gold-400"
                  >
                    <Icon name={s.icon} size={22} class="mt-0.5 shrink-0 text-gold-400" />
                    <span>
                      <span class="block font-medium text-pearl group-hover:text-gold-200">{s.name}</span>
                      <span class="mt-1 block text-sm leading-relaxed text-mist">{s.summary}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="mt-6 text-sm text-smoke">
            ¿Quieres ver lo que hemos desarrollado? Revisa nuestro <a href="/portafolio/" class="link-inline">portafolio</a>{' '}o resuelve dudas en <a href="/preguntas-frecuentes/" class="link-inline">preguntas frecuentes</a>.
          </p>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- Qué esperar -->
  <Section id="que-esperar" eyebrow="Qué esperar" title={c.stepsTitle} intro={c.stepsIntro} tone="raised">
    <ol class="grid gap-5 md:grid-cols-2 lg:grid-cols-4" role="list">
      {
        c.steps.map((step, i) => (
          <Reveal as="li" effect="scale" delay={i * 100} class="glass relative flex flex-col rounded-(--radius-card) p-7">
            <div class="flex items-center justify-between">
              <span class="inline-flex size-12 items-center justify-center rounded-2xl border border-line-gold text-gold-300">
                <Icon name={stepIcons[i] ?? 'check'} size={22} />
              </span>
              <span class="text-display-sm font-semibold text-gold" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>
            <h3 class="mt-6 text-lg font-semibold tracking-[-0.015em]">
              <span class="sr-only">Paso {i + 1}: </span>
              {step.title}
            </h3>
            <p class="mt-3 leading-relaxed text-mist">{step.text}</p>
          </Reveal>
        ))
      }
    </ol>
  </Section>

  <!-- Cobertura -->
  <Section id="cobertura" eyebrow="Cobertura" title={c.coverageTitle} intro={c.coverageText}>
    <ul class="flex flex-wrap gap-3" role="list" aria-label="Algunas ciudades donde atendemos">
      {
        cities.map((city, i) => (
          <Reveal as="li" effect="fade" delay={i * 60} class="glass inline-flex min-h-11 items-center gap-2 rounded-full px-5 text-pearl">
            <Icon name="map-pin" size={16} class="text-gold-400" />
            {city}
          </Reveal>
        ))
      }
      <Reveal as="li" effect="fade" delay={cities.length * 60} class="inline-flex min-h-11 items-center rounded-full border border-line-gold px-5 text-gold-200">
        y todo el país, en remoto
      </Reveal>
    </ul>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      <Card tone="solid" icon="globe" title="100 % remoto" text="Reuniones, revisiones y entregas en línea. Trabajas con nosotros desde tu oficina, en cualquier ciudad." revealDelay={0} />
      <Card tone="solid" icon="whatsapp" title="Un canal directo" text="Hablas por WhatsApp directamente con Nithios, sin intermediarios ni correos que se pierden en una bandeja." revealDelay={100} />
      <Card tone="solid" icon="shield" title="Tus datos, cuidados" text="Sin publicidad, y la analítica solo con tu permiso. De ti solo conocemos lo que decides contarnos por WhatsApp." revealDelay={200} />
    </div>
  </Section>

  <CtaBand
    title={c.ctaTitle}
    text={c.ctaText}
    message={c.whatsappMessage}
    secondary={{ label: 'Ver portafolio', href: '/portafolio/' }}
  />
</BaseLayout>
