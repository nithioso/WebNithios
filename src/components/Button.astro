---
/**
 * Botón/enlace premium. Siempre renderiza <a> si hay `href`, si no <button>.
 * <Button href={waLink('Hola')} variant="gold" icon="whatsapp">Hablemos por WhatsApp</Button>
 * <Button href="/portafolio/" variant="glass" iconRight="arrow-right">Ver portafolio</Button>
 * Targets ≥ 44px en todos los tamaños.
 */
import Icon from './Icon.astro';
import type { IconName } from '@/lib/icons';

interface Props {
  href?: string;
  variant?: 'gold' | 'glass' | 'outline' | 'ghost' | 'link';
  size?: 'sm' | 'md' | 'lg';
  /** Ícono a la izquierda. */
  icon?: IconName;
  /** Ícono a la derecha (se desplaza al hover). */
  iconRight?: IconName;
  /** Abre en pestaña nueva con rel seguro. Se activa solo para wa.me si no se indica. */
  external?: boolean;
  ariaLabel?: string;
  type?: 'button' | 'submit' | 'reset';
  fullWidth?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  href,
  variant = 'gold',
  size = 'md',
  icon,
  iconRight,
  external,
  ariaLabel,
  type = 'button',
  fullWidth = false,
  class: className,
  ...rest
} = Astro.props;

const isExternal = external ?? (href ? /^https?:\/\//.test(href) : false);

const base =
  'group/btn relative inline-flex items-center justify-center gap-2.5 max-w-full text-center text-balance sm:whitespace-nowrap font-medium tracking-[-0.01em] rounded-full transition-[transform,background-color,box-shadow,color,border-color] duration-300 ease-(--ease-apple) active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-400';

const sizes = {
  sm: 'min-h-11 px-5 text-[0.9375rem]',
  md: 'min-h-12 px-6 text-base',
  lg: 'min-h-14 px-8 text-[1.0625rem]',
}[size];

const variants = {
  gold: 'bg-gold text-ink-950 font-semibold shadow-gold hover:shadow-[0_14px_50px_-12px_rgb(212_175_55/0.65)] hover:-translate-y-0.5 [background-size:200%_auto] hover:[background-position:100%_center]',
  glass: 'glass text-pearl hover:bg-white/10 hover:border-line-strong',
  outline: 'border border-line-gold text-gold-200 hover:bg-gold-500/10 hover:border-gold-400',
  ghost: 'text-pearl hover:bg-white/6',
  link: 'min-h-11 px-0! text-gold-300 hover:text-gold-200 rounded-md',
}[variant];

const classes = [base, sizes, variants, fullWidth && 'w-full', className];
---

{
  href ? (
    <a
      href={href}
      class:list={classes}
      aria-label={ariaLabel}
      target={isExternal ? '_blank' : undefined}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      {...rest}
    >
      {icon && <Icon name={icon} size={size === 'lg' ? 22 : 20} />}
      <span>
        <slot />
      </span>
      {iconRight && (
        <Icon
          name={iconRight}
          size={18}
          class="transition-transform duration-300 ease-(--ease-apple) group-hover/btn:translate-x-1"
        />
      )}
      {isExternal && !ariaLabel && <span class="sr-only">(se abre en una pestaña nueva)</span>}
    </a>
  ) : (
    <button type={type} class:list={classes} aria-label={ariaLabel} {...rest}>
      {icon && <Icon name={icon} size={size === 'lg' ? 22 : 20} />}
      <span>
        <slot />
      </span>
      {iconRight && <Icon name={iconRight} size={18} />}
    </button>
  )
}
