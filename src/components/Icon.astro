---
/**
 * Ícono SVG en línea (decorativo por defecto).
 * <Icon name="compass" size={24} class="text-gold-400" />
 * <Icon name="whatsapp" label="WhatsApp" />  → con `label` deja de ser decorativo.
 * Los íconos de SPRITE_ICONS se dibujan con <use> sobre el sprite de BaseLayout (menos HTML).
 * Trazo, relleno y flex-shrink salen de las clases .ico / .ico-f (global.css); un strokeWidth distinto de 1.6 va en style.
 */
import { icons, FILLED_ICONS, SPRITE_ICONS, type IconName } from '@/lib/icons';

interface Props {
  name: IconName;
  size?: number | string;
  /** Texto accesible. Si se omite, el ícono es aria-hidden. */
  label?: string;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 24, label, strokeWidth = 1.6, class: className } = Astro.props;
const filled = FILLED_ICONS.has(name);
const inner = SPRITE_ICONS.has(name) ? `<use href="#i-${name}"/>` : icons[name];
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class:list={[filled ? 'ico ico-f' : 'ico', className]}
  style={!filled && strokeWidth !== 1.6 ? `stroke-width:${strokeWidth}` : undefined}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={inner}
/>
