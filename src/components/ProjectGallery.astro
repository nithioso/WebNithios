---
/**
 * Galería de capturas reales de un proyecto (figure + figcaption).
 * Capturas de escritorio (marco de navegador): la primera ocupa todo el ancho; el resto va en dos columnas.
 * Capturas verticales de móvil (marco de teléfono, `frame: 'phone'` o proporción vertical): fila centrada
 * de teléfonos (2 por fila en móvil, 3 en tableta, hasta 5 en escritorio) debajo de las de escritorio.
 * Cada captura enlaza al archivo a tamaño completo (en móvil los textos de un dashboard de 1440 px no se leen).
 * Accesibilidad: el alt descriptivo va en la <img> (nunca vacío: es contenido) y el nombre del enlace se compone
 * de ese alt + un texto sr-only que avisa de la pestaña nueva.
 * <ProjectGallery images={p.images} label="Plataforma de comercio internacional · prototipo" />
 */
import { Image } from 'astro:assets';
import BrowserFrame from './BrowserFrame.astro';
import PhoneFrame from './PhoneFrame.astro';
import Icon from './Icon.astro';
import type { ProjectImage } from '@/data/projects';

interface Props {
  images: ProjectImage[];
  label?: string;
  class?: string;
}

const { images: all, label, class: className } = Astro.props;
const isPhone = (img: ProjectImage) => (img.frame ?? (img.src.height > img.src.width ? 'phone' : 'browser')) === 'phone';
const images = all.filter((img) => !isPhone(img));
const phones = all.filter(isPhone);
---

{
  images.length > 0 && (
    <ul class:list={['grid gap-x-6 gap-y-14 md:grid-cols-2 md:gap-y-16', className]} role="list">
      {images.map((img, i) => (
        <li class:list={[i === 0 && 'md:col-span-2']} data-reveal style={`--reveal-delay:${(i % 2) * 100}ms`}>
          <figure>
            <a
              href={img.src.src}
              target="_blank"
              rel="noopener"
              class="group/zoom relative block rounded-(--radius-card) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-400"
            >
              <BrowserFrame label={label}>
                <Image
                  src={img.src}
                  alt={img.alt}
                  widths={i === 0 ? [640, 960, 1280, 1920, 2560] : [480, 720, 960, 1280]}
                  sizes={i === 0 ? '(min-width: 1280px) 1240px, 100vw' : '(min-width: 1280px) 610px, (min-width: 768px) 48vw, 100vw'}
                  class="block h-auto w-full"
                />
              </BrowserFrame>
              <span class="sr-only">(ver captura completa, se abre en una pestaña nueva)</span>
              <span
                class="absolute bottom-3 right-3 inline-flex size-11 items-center justify-center rounded-full glass-strong border border-line-gold text-gold-200 transition-transform duration-300 ease-(--ease-apple) group-hover/zoom:scale-110 md:bottom-5 md:right-5"
                aria-hidden="true"
              >
                <Icon name="search" size={18} />
              </span>
            </a>
            <figcaption class="mt-5 max-w-2xl text-sm leading-relaxed text-mist md:text-base">
              {img.caption}
              <span class="mt-1 block text-xs text-smoke md:hidden">Toca la imagen para ampliarla.</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  )
}

{
  phones.length > 0 && (
    <ul
      class:list={['flex flex-wrap justify-center gap-x-5 gap-y-12 sm:gap-x-8 lg:gap-x-6', images.length > 0 && 'mt-16 md:mt-20', images.length === 0 && className]}
      role="list"
    >
      {phones.map((img, i) => (
        <li class="w-[calc(50%-0.625rem)] max-w-[15rem] sm:w-[calc(33.333%-1.35rem)] lg:w-[calc(20%-1.2rem)]" data-reveal style={`--reveal-delay:${(i % 5) * 70}ms`}>
          <figure>
            <a
              href={img.src.src}
              target="_blank"
              rel="noopener"
              class="group/zoom relative block rounded-[2.25rem] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-400 md:rounded-[2.6rem]"
            >
              <PhoneFrame class="transition-transform duration-500 ease-(--ease-apple) group-hover/zoom:-translate-y-1">
                <Image src={img.src} alt={img.alt} widths={[240, 360, 480, 720]} sizes="(min-width: 1024px) 15rem, (min-width: 640px) 30vw, 46vw" class="block h-auto w-full" />
              </PhoneFrame>
              <span class="sr-only">(ver captura completa, se abre en una pestaña nueva)</span>
            </a>
            <figcaption class="mt-4 text-sm leading-relaxed text-mist">{img.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  )
}
