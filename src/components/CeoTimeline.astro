---
/**
 * Línea de tiempo de la trayectoria del CEO, SIN fechas (regla del usuario) y con empleadores anonimizados.
 * Orden: del cargo más reciente al más antiguo. El primer nodo (opcional) es su rol en Nithios.
 * <CeoTimeline items={ceo.experience} lead={{ role: 'CEO y Fundador', organization: 'Nithios', text: '…' }} />
 * En ≥md cada hito es una fila de dos columnas: cargo + organización | logros.
 */
import Icon from './Icon.astro';
import type { ExperienceItem } from '@/data/ceo';

interface Props {
  items: ExperienceItem[];
  /** Nodo destacado al inicio (rol en Nithios). */
  lead?: { role: string; organization: string; text: string };
  class?: string;
}

const { items, lead, class: className } = Astro.props;
---

<ol class:list={['relative', className]}>
  <!-- Riel vertical: hairline dorada que se desvanece al final -->
  <span
    class="pointer-events-none absolute top-3 bottom-0 left-[0.6875rem] w-px bg-linear-to-b from-gold-500/70 via-line-gold to-transparent"
    aria-hidden="true"
  ></span>

  {
    lead && (
      <li class="relative pb-12 pl-9 md:pb-16 md:pl-16" data-reveal>
        <span class="absolute top-1 left-0 grid size-6 place-items-center rounded-full bg-gold shadow-gold" aria-hidden="true">
          <span class="size-2 rounded-full bg-ink-950" />
        </span>
        <div class="gold-ring relative rounded-(--radius-card) bg-ink-800/70 p-6 md:p-9">
          <p class="eyebrow text-[0.75rem]">En paralelo</p>
          <h3 class="mt-3 text-display-sm font-semibold text-pearl">
            {lead.role} <span class="text-gold">· {lead.organization}</span>
          </h3>
          <p class="mt-3 max-w-3xl leading-relaxed text-mist">{lead.text}</p>
        </div>
      </li>
    )
  }

  {
    items.map((e, i) => (
      <li class="relative pl-9 md:pl-16" data-reveal style={`--reveal-delay:${Math.min(i, 3) * 60}ms`}>
        <span
          class:list={[
            'absolute top-1.5 left-[0.3125rem] size-3.5 rounded-full border-2',
            e.current ? 'border-gold-400 bg-gold-500 shadow-gold' : 'border-gold-600/80 bg-ink-900',
          ]}
          aria-hidden="true"
        />
        <div class="grid gap-5 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:gap-12">
          <div>
            {e.current && (
              <p class="mb-3 inline-flex items-center gap-2 rounded-full border border-line-gold bg-gold-500/10 px-3 py-1 text-xs font-semibold tracking-[0.08em] text-gold-200 uppercase">
                <span class="size-1.5 rounded-full bg-gold-400" aria-hidden="true" />
                Actual
              </p>
            )}
            <h3 class="text-xl font-semibold tracking-[-0.02em] text-pearl md:text-2xl">{e.role}</h3>
            <p class="mt-2 text-gold-300">{e.organization}</p>
          </div>
          <ul class="space-y-3">
            {e.achievements.map((a) => (
              <li class="flex gap-3 leading-relaxed text-mist">
                <Icon name="check" size={18} class="mt-1 shrink-0 text-gold-400" />
                <span>{a}</span>
              </li>
            ))}
          </ul>
        </div>
        {i < items.length - 1 && <span class="my-10 block h-px bg-line md:my-12" aria-hidden="true" />}
      </li>
    ))
  }
</ol>
