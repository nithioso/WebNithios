---
/**
 * Cuerpo completo de una página de detalle de servicio (área Servicios).
 * Combina `Service` (services.ts) + `ServiceDetail` (service-details.ts).
 * La página aporta BaseLayout (SEO/JSON-LD); este componente aporta hero (h1), secciones y CTA.
 * <ServiceDetailContent service={s} detail={d} breadcrumbs={crumbs} />
 */
import ScrollerSync from './ScrollerSync.astro';
import PageHero from './PageHero.astro';
import ServiceHeroArt from './ServiceHeroArt.astro';
import Section from './Section.astro';
import Card from './Card.astro';
import ProjectCard from './ProjectCard.astro';
import FaqList from './FaqList.astro';
import CtaBand from './CtaBand.astro';
import Button from './Button.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import Icon from './Icon.astro';
import Reveal from './Reveal.astro';
import GuidesBlock from './GuidesBlock.astro';
import { cities, coverage } from '@/data/site';
import { getService, type Service } from '@/data/services';
import { sortedProjects, getProject } from '@/data/projects';
import type { ServiceDetail } from '@/data/service-details';
import type { Crumb } from '@/lib/schema';
import { servicePagesForLine, servicePagePath } from '@/data/servicios';
import type { LineSlug } from '@/data/mapa-contenido';

interface Props {
  service: Service;
  detail: ServiceDetail;
  breadcrumbs: Crumb[];
}

const { service: s, detail: d, breadcrumbs } = Astro.props;

/* Casos: los indicados en projectSlugs; si no hay, los ligados al servicio; si no hay, todos los destacados. */
const byService = sortedProjects.filter((p) => p.serviceSlug === s.slug);
const relatedProjects = d.projectSlugs.length
  ? d.projectSlugs.map((slug) => getProject(slug)).filter((p): p is NonNullable<typeof p> => Boolean(p))
  : byService.length
    ? byService
    : sortedProjects.filter((p) => p.featured);

const other = getService(d.crossSell.slug);

/* Servicios específicos de esta línea (src/data/servicios/*.ts con parent = esta línea o 'ambas'). */
const specific = servicePagesForLine(s.slug as LineSlug);

/* Bento 6 columnas: 4+2 / 2+2+2 / 3+3 (7 elementos); el resto ocupa 2. */
const spans = ['md:col-span-4', 'md:col-span-2', 'md:col-span-2', 'md:col-span-2', 'md:col-span-2', 'md:col-span-3', 'md:col-span-3'];

const heroChips = [
  { icon: 'map-pin' as const, text: coverage.short },
  { icon: 'award' as const, text: 'Un CEO con casi 20 años de experiencia' },
  { icon: 'target' as const, text: 'Propuesta ajustada a tu caso' },
];
---

<PageHero
  eyebrow={d.heroEyebrow}
  title={s.name}
  titleHtml={d.heroTitleHtml}
  intro={s.intro[0]}
  breadcrumbs={breadcrumbs}
  whatsappMessage={s.whatsappMessage}
  secondary={{ label: 'Ver portafolio', href: '/portafolio/' }}
>
  <ul class="mt-12 flex flex-wrap gap-2.5" aria-label="Por qué Nithios" data-reveal="fade" style="--reveal-delay:320ms">
    {
      heroChips.map((c) => (
        <li class="inline-flex items-center gap-2 rounded-full border border-line bg-ink-900/60 px-4 py-2 text-sm text-mist">
          <Icon name={c.icon} size={16} class="text-gold-400" />
          {c.text}
        </li>
      ))
    }
  </ul>
  <ServiceHeroArt slot="aside" items={[{ icon: s.icon, title: s.shortName, points: d.deliverables.map((x) => x.title) }]} />
</PageHero>

<!-- ¿Qué es? — respuesta directa citable -->
<Section id="que-es" eyebrow="En pocas palabras" title={d.whatIs.question} spacing="md">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
    <Reveal class="lg:col-span-5">
      <p class="border-l-2 border-gold-500/70 pl-6 text-xl leading-snug font-medium tracking-[-0.015em] text-pearl md:text-2xl">
        {d.whatIs.answer}
      </p>
    </Reveal>
    <Reveal class="prose-nithios lg:col-span-7" delay={120}>
      {d.whatIs.paragraphs.map((para) => <p>{para}</p>)}
      {s.intro[1] && <p>{s.intro[1]}</p>}
    </Reveal>
  </div>
</Section>

{
  d.guide && (
    <Section id="por-donde-empezar" eyebrow={d.guide.eyebrow} title={d.guide.title} spacing="md" tone="glow">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <Reveal class="lg:col-span-5">
          <p class="border-l-2 border-gold-500/70 pl-6 text-xl leading-snug font-medium tracking-[-0.015em] text-pearl md:text-2xl">
            {d.guide.answer}
          </p>
        </Reveal>
        <Reveal class="prose-nithios lg:col-span-7" delay={120}>
          {d.guide.paragraphs.map((para) => <p>{para}</p>)}
        </Reveal>
      </div>
    </Section>
  )
}

<!-- Para quién -->
<Section id="para-quien" eyebrow="Para quién" title={d.headings.audience} intro={d.audienceIntro} tone="raised">
  <ul class="grid gap-5 md:grid-cols-2">
    {
      s.idealFor.map((item, i) => (
        <Reveal as="li" delay={i * 80} class="flex items-start gap-4 rounded-(--radius-card) hairline bg-ink-900 p-6 md:p-7">
          <span class="mt-0.5 inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-line-gold text-gold-300">
            <Icon name="check" size={18} />
          </span>
          <span class="text-lg leading-relaxed text-pearl">{item}</span>
        </Reveal>
      ))
    }
  </ul>
</Section>

<!-- Problemas que resuelve -->
<Section id="problemas" eyebrow="Problemas que resolvemos" title={d.headings.problems}>
  <!-- Móvil: carrusel horizontal con scroll-snap (página más corta); desde sm: rejilla. -->
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 max-sm:-mx-5 max-sm:flex max-sm:snap-x max-sm:snap-mandatory max-sm:overflow-x-auto max-sm:px-5 max-sm:scroll-px-5 max-sm:pb-3 max-sm:[scrollbar-width:thin] max-sm:*:w-[85%] max-sm:*:shrink-0 max-sm:*:snap-start" data-scroller="Problemas que resolvemos (desliza para ver más)">
    {d.problems.map((p, i) => <Card tone="solid" icon={p.icon} title={p.title} text={p.text} revealDelay={(i % 3) * 90} />)}
  </div>
</Section>

<!-- Qué incluye (bento) -->
<Section id="que-incluye" eyebrow="Qué incluye" title={d.headings.inclusions} intro={d.inclusionsIntro} tone="raised">
  <div class="grid gap-5 md:grid-cols-6">
    {
      d.inclusions.map((inc, i) => (
        <Card
          class={spans[i] ?? 'md:col-span-2'}
          tone={i === 0 ? 'gold' : 'glass'}
          size={i === 0 ? 'lg' : 'md'}
          icon={inc.icon}
          title={inc.title}
          text={inc.text}
          revealDelay={(i % 3) * 90}
        >
          {inc.points.length > 0 && (
            <ul class="mt-6 space-y-2.5">
              {inc.points.map((pt) => (
                <li class="flex items-start gap-2.5 text-sm text-mist">
                  <Icon name="check" size={16} class="mt-0.5 shrink-0 text-gold-400" />
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          )}
        </Card>
      ))
    }
  </div>
</Section>

<!-- Servicios específicos de la línea -->
{
  specific.length > 0 && (
    <Section
      id="servicios-especificos"
      eyebrow="Servicios específicos"
      title={`Servicios de ${s.shortName.toLowerCase()}`}
      intro="Si ya sabes qué necesitas, entra directo al servicio."
    >
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {specific.map((p, i) => (
          <Card tone="outline" icon={p.icon} title={p.name} text={p.summary} href={servicePagePath(p.slug)} revealDelay={(i % 3) * 80}>
            <Fragment slot="footer">
              <span class="inline-flex items-center gap-1.5 text-sm font-medium text-gold-300" aria-hidden="true">
                Conocer el servicio
                <Icon name="arrow-right" size={16} class="transition-transform duration-300 group-hover:translate-x-1" />
              </span>
            </Fragment>
          </Card>
        ))}
      </div>
    </Section>
  )
}

<!-- Bloque destacado (IA para empresas / MVP) -->
<Section id="destacado" tone="glow" eyebrow={d.spotlight.eyebrow} title={d.spotlight.title} titleSize="lg">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
    <Reveal class="prose-nithios lg:col-span-7">
      {d.spotlight.paragraphs.map((para) => <p>{para}</p>)}
      {
        s.slug === 'consultoria-tecnologica' && (
          <p>
            Conoce la trayectoria de <a href="/jonathan-osorio/">Jonathan Osorio, CEO y Fundador de Nithios</a>.
          </p>
        )
      }
      {
        s.slug === 'desarrollo-de-software-a-medida' && (
          <p>
            Mira el caso completo de <a href="/portafolio/plataforma-comercio-internacional/">la plataforma de comercio internacional</a> en nuestro portafolio.
          </p>
        )
      }
    </Reveal>
    <Reveal class="lg:col-span-5" effect="scale" delay={120}>
      <div class="gold-ring glass-strong rounded-(--radius-card) p-8 md:p-10">
        <ul class="space-y-4">
          {
            d.spotlight.points.map((pt) => (
              <li class="flex items-start gap-3 text-pearl">
                <Icon name="check-circle" size={22} class="mt-0.5 shrink-0 text-gold-400" />
                <span class="leading-relaxed">{pt}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-8">
          <WhatsAppButton message={s.whatsappMessage} fullWidth />
        </div>
      </div>
    </Reveal>
  </div>
</Section>

<!-- Proceso -->
<Section id="proceso" eyebrow="Método" title={d.headings.process} intro={d.processIntro} tone="raised">
  <ol class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {
      d.process.map((step, i) => (
        <Reveal as="li" delay={(i % 3) * 90} class="relative rounded-(--radius-card) hairline bg-ink-900 p-7 md:p-8">
          <span class="font-display text-display-sm font-semibold text-gold" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-4 text-xl font-semibold tracking-[-0.02em] text-pearl">
            <span class="sr-only">Paso {i + 1}: </span>
            {step.title}
          </h3>
          <p class="mt-3 leading-relaxed text-mist">{step.text}</p>
        </Reveal>
      ))
    }
  </ol>
</Section>

<!-- Entregables + beneficios -->
<Section id="entregables" eyebrow="Entregables" title={d.headings.deliverables} intro={d.deliverablesIntro}>
  <ul class="divide-y divide-line border-y border-line">
    {
      d.deliverables.map((del, i) => (
        <Reveal as="li" delay={i * 60} class="grid gap-2 py-6 md:grid-cols-12 md:gap-8 md:py-7">
          <h3 class="flex items-start gap-3 text-lg font-semibold tracking-[-0.015em] text-pearl md:col-span-5 md:text-xl">
            <Icon name="check-circle" size={22} class="mt-0.5 shrink-0 text-gold-400" />
            {del.title}
          </h3>
          <p class="pl-[34px] leading-relaxed text-mist md:col-span-7 md:pl-0">{del.text}</p>
        </Reveal>
      ))
    }
  </ul>
</Section>

<Section id="beneficios" eyebrow="Por qué Nithios" title="Beneficios que se notan en tu operación." tone="raised">
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {s.benefits.map((b, i) => <Card tone="glass" icon={b.icon} title={b.title} text={b.text} revealDelay={i * 80} />)}
  </div>
  {
    s.technologies && s.technologies.length > 0 && (
      <Reveal class="mt-16">
        <h3 class="text-xl font-semibold tracking-[-0.02em] text-pearl">Tecnologías modernas, elegidas para cada proyecto</h3>
        <p class="mt-3 max-w-2xl leading-relaxed text-mist">
          Elegimos el stack según las necesidades de cada aplicativo. Estas son tecnologías con las que construimos{' '}
          <a href="/portafolio/krystal/" class="link-inline">Krystal</a>:
        </p>
        <ul class="mt-6 flex flex-wrap gap-2.5" aria-label="Tecnologías">
          {s.technologies.map((t) => (
            <li class="rounded-full border border-line bg-ink-900 px-4 py-2 text-sm text-pearl">{t}</li>
          ))}
        </ul>
      </Reveal>
    )
  }
</Section>

<!-- Sectores -->
<Section id="sectores" eyebrow="Sectores" title={d.headings.sectors} intro={d.sectorsIntro}>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 max-sm:-mx-5 max-sm:flex max-sm:snap-x max-sm:snap-mandatory max-sm:overflow-x-auto max-sm:px-5 max-sm:scroll-px-5 max-sm:pb-3 max-sm:[scrollbar-width:thin] max-sm:*:w-[85%] max-sm:*:shrink-0 max-sm:*:snap-start" data-scroller="Sectores (desliza para ver más)">
    {
      d.sectors.map((sec, i) => {
        const project = sec.projectSlug ? getProject(sec.projectSlug) : undefined;
        return project ? (
          <Card tone="outline" size="sm" icon={sec.icon} title={sec.name} text={sec.text} href={project.path} revealDelay={(i % 3) * 80}>
            <Fragment slot="footer">
              <span class="inline-flex items-center gap-1.5 text-sm font-medium text-gold-300" aria-hidden="true">
                Ver caso {project.name}
                <Icon name="arrow-right" size={16} class="transition-transform duration-300 group-hover:translate-x-1" />
              </span>
            </Fragment>
          </Card>
        ) : (
          <Card tone="outline" size="sm" icon={sec.icon} title={sec.name} text={sec.text} revealDelay={(i % 3) * 80} />
        );
      })
    }
  </div>
</Section>

<!-- Portafolio relacionado -->
{
  relatedProjects.length > 0 && (
    <Section id="casos" eyebrow="Portafolio" title={d.headings.portfolio} intro={d.portfolioIntro} tone="raised">
      <div class="grid gap-6 md:grid-cols-2">
        {relatedProjects.map((p, i) => (
          <ProjectCard project={p} revealDelay={i * 100} />
        ))}
      </div>
      <Fragment slot="actions">
        <Button href="/portafolio/" variant="glass" iconRight="arrow-right">
          Ver todo el portafolio
        </Button>
      </Fragment>
    </Section>
  )
}

<!-- Cobertura Colombia -->
<Section id="cobertura" eyebrow="Cobertura" title={d.coverageTitle} spacing="md">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
    <Reveal class="lg:col-span-7">
      <p class="text-lead text-mist">{d.coverageText}</p>
    </Reveal>
    <Reveal class="lg:col-span-5" delay={120}>
      <ul class="flex flex-wrap gap-2.5" aria-label="Ciudades donde atendemos de forma remota">
        {
          cities.map((c) => (
            <li class="inline-flex items-center gap-2 rounded-full border border-line bg-ink-850 px-4 py-2 text-sm text-pearl">
              <Icon name="map-pin" size={15} class="text-gold-400" />
              {c}
            </li>
          ))
        }
        <li class="inline-flex items-center rounded-full border border-dashed border-line px-4 py-2 text-sm text-mist">
          y todo el país
        </li>
      </ul>
    </Reveal>
  </div>
</Section>

<!-- FAQ específica -->
<Section
  id="preguntas"
  eyebrow="Preguntas frecuentes"
  title={`Preguntas frecuentes sobre ${s.shortName.toLowerCase()}`}
  tone="raised"
  width="narrow"
>
  <FaqList items={d.faqs} openFirst />
  <Fragment slot="actions">
    <Button href="/preguntas-frecuentes/" variant="link" iconRight="arrow-right">Ver todas las preguntas</Button>
  </Fragment>
</Section>

<!-- Guías de la línea (src/data/guias.ts › featuredGuides) -->
<GuidesBlock set={s.slug as LineSlug} />

<!-- Servicio complementario -->
{
  other && (
    <Section id="complemento" spacing="sm" ariaLabel="Servicio complementario">
      <Card
        tone="gold"
        size="lg"
        icon={other.icon}
        eyebrow={`También ofrecemos · ${other.shortName}`}
        title={d.crossSell.title}
        text={d.crossSell.text}
        href={other.path}
        headingLevel="h2"
      >
        <Fragment slot="footer">
          <span class="inline-flex items-center gap-1.5 text-sm font-medium text-gold-300" aria-hidden="true">
            Conocer {other.shortName.toLowerCase()}
            <Icon name="arrow-right" size={16} class="transition-transform duration-300 group-hover:translate-x-1" />
          </span>
        </Fragment>
      </Card>
    </Section>
  )
}

<CtaBand
  title={d.cta.title}
  text={d.cta.text}
  message={s.whatsappMessage}
  secondary={{ label: 'Ver portafolio', href: '/portafolio/' }}
/>

<ScrollerSync />
