/**
 * Logo de Nithios — K · «NTOS en sello» (oficial). Fuente: design/logo/final/ (derivado de design/logo/v3/ntos-sello/).
 * Moneda de oro (la O) con la ligadura NT tallada dentro y un corte en S que la parte en dos piezas: luz (arriba a la
 * izquierda) y sombra. La NT es un hueco: deja ver el fondo.
 * INTERFAZ ESTABLE:
 * <Logo />                          → isotipo + wordmark, tamaño md
 * <Logo variant="mark" size="lg" /> → solo isotipo
 * <Logo variant="wordmark" />       → solo texto
 * <Logo tone="mono" />              → monocromo (currentColor)
 * Versión negativo (sitio oscuro). Si cambia la geometría: actualiza design/logo/v3/ntos-sello/, ejecuta
 * `node design/logo/v3/ntos-sello/derive-final.mjs`, copia aquí los paths de final/mark.svg y final/app-icon.svg y ejecuta `npm run brand`.
 */
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl';
  variant?: 'full' | 'mark' | 'wordmark';
  tone?: 'gold' | 'mono';
  /** Si se pasa, el logo se vuelve un enlace (p. ej. '/'). */
  href?: string;
  class?: string;
}

const { size = 'md', variant = 'full', tone = 'gold', href, class: className } = Astro.props;

