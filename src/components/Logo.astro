---
/**
 * Logo de Nithios — K · «NTOS en sello» (oficial). Fuente: design/logo/final/ (derivado de design/logo/v3/ntos-sello/).
 * Moneda de oro (la O) con la ligadura NT tallada dentro y un corte en S que la parte en dos piezas: luz (arriba a la
 * izquierda) y sombra. La NT es un hueco: deja ver el fondo.
 * INTERFAZ ESTABLE:
 * <Logo />                          → isotipo + wordmark, tamaño md
 * <Logo variant="mark" size="lg" /> → solo isotipo
 * <Logo variant="wordmark" />       → solo texto
 * <Logo tone="mono" />              → monocromo (currentColor)
 * Tono dorado: la geometría y los degradados viven UNA vez por página en el sprite (IconSprite.astro, ids #nl-*) y aquí se
 * dibujan con <use>; el tono mono va en línea. Constantes en src/lib/logo.ts.
 * Versión negativo (sitio oscuro). Si cambia la geometría: actualiza design/logo/v3/ntos-sello/, ejecuta
 * `node design/logo/v3/ntos-sello/derive-final.mjs`, copia en src/lib/logo.ts los paths de final/mark.svg y final/app-icon.svg y ejecuta `npm run brand`.
 */
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl';
  variant?: 'full' | 'mark' | 'wordmark';
  tone?: 'gold' | 'mono';
  /** Si se pasa, el logo se vuelve un enlace (p. ej. '/'). */
  href?: string;
  class?: string;
}

const { size = 'md', variant = 'full', tone = 'gold', href, class: className } = Astro.props;

import { FINE_LIGHT, FINE_SHADE, OPT_LIGHT, OPT_SHADE, OPT_T, WORD, WORD_T } from '@/lib/logo';

/** Diámetro de la moneda en px por tamaño (el círculo necesita más alto que un bloque para igual presencia óptica). */
const h = { sm: 36, md: 40, lg: 50, xl: 68 }[size];
const optical = size === 'sm' || size === 'md';
const box = {
  full: { vb: '4 4 200.45 56', w: (h * 200.45) / 56, h },
  mark: { vb: '4 4 56 56', w: h, h },
  // Solo texto: misma altura de mayúscula que en el horizontal (21,2/56 de h).
  wordmark: { vb: '73 20.9 131.45 22.2', w: (h * 131.45) / 56, h: (h * 22.2) / 56 },
}[variant];

const gold = tone === 'gold';
const ink = gold ? 'var(--color-pearl, #f5f1e8)' : 'currentColor';
const Tag = href ? 'a' : 'span';
// Dorado en sm/md (header, footer, CEO): geometría del sprite (IconSprite.astro, #nl-coin / #nl-word). lg/xl y mono: en línea.
const sprite = gold && optical;
const uid = sprite ? '' : Math.random().toString(36).slice(2, 8);
const ga = `nithios-luz-${uid}`;
const gb = `nithios-sombra-${uid}`;
---

<Tag
  href={href}
  class:list={['group inline-flex items-center select-none', href && 'min-h-11', className]}
  aria-label={href ? 'Nithios, ir al inicio' : undefined}
>
  <svg
    width={Math.round(box.w * 10) / 10}
    height={Math.round(box.h * 10) / 10}
    viewBox={box.vb}
    fill="none"
    aria-hidden="true"
    class="block shrink-0 overflow-visible"
  >
    {
      sprite ? (
        <Fragment>
          {variant !== 'wordmark' && (
            <use href="#nl-coin" class="transition-[filter] duration-700 ease-(--ease-apple) group-hover:brightness-115" />
          )}
          {variant !== 'mark' && <use href="#nl-word" fill={ink} />}
        </Fragment>
      ) : (
        <Fragment>
          {gold && variant !== 'wordmark' && (
            <defs>
              <linearGradient id={ga} x1="8" y1="6" x2="52" y2="60" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#f3e2a6" />
                <stop offset=".55" stop-color="#e0bf5c" />
                <stop offset="1" stop-color="#c9a03f" />
              </linearGradient>
              <linearGradient id={gb} x1="56" y1="60" x2="10" y2="6" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#d4af37" />
                <stop offset=".5" stop-color="#b8913a" />
                <stop offset="1" stop-color="#9a7628" />
              </linearGradient>
            </defs>
          )}
          {variant !== 'wordmark' && (
            <g class="transition-[filter] duration-700 ease-(--ease-apple) group-hover:brightness-115">
              <g transform={optical ? OPT_T : undefined}>
                <path d={optical ? OPT_LIGHT : FINE_LIGHT} fill={gold ? `url(#${ga})` : 'currentColor'} />
                <path d={optical ? OPT_SHADE : FINE_SHADE} fill={gold ? `url(#${gb})` : 'currentColor'} />
              </g>
            </g>
          )}
          {variant !== 'mark' && <path d={WORD} transform={WORD_T} fill={ink} />}
        </Fragment>
      )
    }
  </svg>
  {!href && <span class="sr-only">Nithios</span>}
</Tag>
