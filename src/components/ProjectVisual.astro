---
/**
 * Visual principal de un proyecto del portafolio dentro de un marco de navegador.
 * Selección del visual en ProjectArt.astro (cover → illustration → monograma).
 * Con `coverPhone` (captura móvil vertical) se superpone un teléfono en la esquina inferior derecha.
 * Barra del navegador: dominio de `liveUrl` (producto en línea, dominio confirmado) o etiqueta neutra.
 * <ProjectVisual project={p} />
 * <ProjectVisual project={p} priority glow sizes="(min-width: 1280px) 1240px, (min-width: 768px) 100vw, 165vw" />
 */
import { Image } from 'astro:assets';
import BrowserFrame from './BrowserFrame.astro';
import PhoneFrame from './PhoneFrame.astro';
import ProjectArt from './ProjectArt.astro';
import type { Project } from '@/data/projects';

interface Props {
  project: Project;
  /** Imagen por encima del pliegue (carga inmediata, fetchpriority alta). */
  priority?: boolean;
  glow?: boolean;
  sizes?: string;
  class?: string;
}

const {
  project: p,
  priority = false,
  glow = false,
  sizes,
  class: className,
} = Astro.props;
// Etiqueta neutra (no es una URL) salvo en productos en línea: no se muestran dominios que no estén confirmados.
const label = p.liveUrl ? new URL(p.liveUrl).hostname : p.status === 'prototipo' ? `${p.name} · prototipo` : p.name;
const phone = p.cover ? p.coverPhone : undefined;
---

{
  phone ? (
    <div class:list={['relative pb-[7%] pr-[3%]', className]}>
      <BrowserFrame label={label} glow={glow}>
        <ProjectArt project={p} variant="frame" priority={priority} sizes={sizes} />
      </BrowserFrame>
      <div class="absolute bottom-0 right-0 w-[24%] max-w-[17rem] drop-shadow-[0_30px_60px_rgb(0_0_0/0.8)]">
      <PhoneFrame>
        <Image
          src={phone}
          alt={p.coverPhoneAlt ?? `${p.name} en el celular`}
          widths={[160, 240, 320, 480, 640]}
          sizes="(min-width: 1280px) 17rem, 24vw"
          loading={priority ? 'eager' : 'lazy'}
          class="block h-auto w-full"
        />
      </PhoneFrame>
      </div>
    </div>
  ) : (
    <BrowserFrame label={label} glow={glow} class={className}>
      <ProjectArt project={p} variant="frame" priority={priority} sizes={sizes} />
    </BrowserFrame>
  )
}
