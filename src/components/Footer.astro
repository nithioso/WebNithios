---
/**
 * Footer rico: marca + CTA, servicios, portafolio, empresa, cobertura en Colombia.
 * Lo incluye BaseLayout.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { site, cities, coverage, legalNav, waLink } from '@/data/site';
import { services } from '@/data/services';
import { sortedProjects } from '@/data/projects';
import { ceo } from '@/data/ceo';

interface Props {
  whatsappMessage?: string;
}

const { whatsappMessage } = Astro.props;
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Servicios',
    links: [{ label: 'Todos los servicios', href: '/servicios/' }, ...services.map((s) => ({ label: s.shortName, href: s.path }))],
  },
  {
    title: 'Portafolio',
    links: [{ label: 'Ver portafolio', href: '/portafolio/' }, ...sortedProjects.map((p) => ({ label: p.shortName || p.name, href: p.path }))],
  },
  {
    title: 'Nithios',
    links: [
      { label: ceo.name, href: ceo.path },
      { label: 'Preguntas frecuentes', href: '/preguntas-frecuentes/' },
      { label: 'Contacto', href: '/contacto/' },
    ],
  },
];
---

<footer class="relative mt-auto overflow-hidden border-t border-line bg-ink-950" aria-labelledby="footer-titulo">
  <h2 id="footer-titulo" class="sr-only">Información de Nithios</h2>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-[linear-gradient(90deg,transparent,rgb(212_175_55/0.5),transparent)]" aria-hidden="true"></div>

  <div class="container-x pt-16 pb-24 md:py-24">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-3">
        <Logo href="/" size="md" />
        <p class="mt-6 max-w-sm text-mist leading-relaxed">
          Empresa de tecnología colombiana. Consultoría tecnológica para mejorar los procesos de tu empresa y
          desarrollo de software a medida con nuevas tecnologías.
        </p>
        <div class="mt-8">
          <WhatsAppButton message={whatsappMessage} />
        </div>
      </div>

      <nav aria-label="Pie de página" class="grid grid-cols-2 gap-10 sm:grid-cols-3 lg:col-span-6">
        {
          columns.map((col) => (
            <div>
              <h3 class="text-sm font-semibold tracking-normal text-pearl">{col.title}</h3>
              <ul class="mt-4 space-y-1">
                {col.links.map((l) => (
                  <li>
                    <a href={l.href} class="inline-flex min-h-10 items-center text-[0.9375rem] text-smoke transition-colors hover:text-pearl lg:whitespace-nowrap">
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>

      <div class="lg:col-span-3">
        <h3 class="text-sm font-semibold text-pearl">Cobertura en Colombia</h3>
        <p class="mt-4 text-[0.9375rem] text-smoke leading-relaxed">{coverage.short}. Atendemos de forma remota a empresas de:</p>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Ciudades">
          {cities.map((c) => <li class="rounded-full border border-line px-3 py-1 text-xs text-mist">{c}</li>)}
          <li class="rounded-full border border-line-gold px-3 py-1 text-xs text-gold-300">y todo el país</li>
        </ul>
        <a
          href={waLink(whatsappMessage)}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex min-h-11 items-center gap-2 text-[0.9375rem] text-mist hover:text-gold-200"
        >
          <Icon name="whatsapp" size={18} class="text-gold-400" />
          {site.whatsapp.display}
          <span class="sr-only">(WhatsApp, se abre en una pestaña nueva)</span>
        </a>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-line pt-8 text-sm text-smoke md:flex-row md:items-center md:justify-between">
      <p>© {year} {site.name}. Tecnología hecha en Colombia.</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          legalNav.map((l) => (
            <li>
              <a href={l.href} class="inline-flex min-h-10 items-center hover:text-pearl">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
