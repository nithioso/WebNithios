---
/**
 * Layout base de TODAS las páginas.
 * <BaseLayout
 *   title="Consultoría tecnológica en Colombia"          // ≤60 car. con " | Nithios"
 *   description="…140–160 caracteres…"
 *   path="/servicios/consultoria-tecnologica/"            // con trailing slash
 *   breadcrumbs={[{ name: 'Servicios', path: '/servicios/' }, …]}  // → BreadcrumbList JSON-LD
 *   pageType="WebPage"                                    // AboutPage | ContactPage | FAQPage | CollectionPage | ProfilePage
 *   mainEntityId={ids.service(path)}                      // opcional
 *   jsonLd={[service(s)]}                                 // nodos extra (sin @context)
 *   whatsappMessage="Hola Nithios, …"                     // mensaje del FAB/Header/Footer
 * >
 * Siempre incluye en el @graph: Organization/ProfessionalService, WebSite, Person y WebPage.
 */
import '@/styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFab from '@/components/WhatsAppFab.astro';
import IconSprite from '@/components/IconSprite.astro';
import { site } from '@/data/site';
import { ceoPhotoUrl } from '@/lib/images';
import { graph, organization, website, person, webPage, breadcrumbList, type Crumb, type JsonLd } from '@/lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  /** Dimensiones reales de ogImage (por defecto 1200×630). */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Nodos JSON-LD adicionales (sin @context). */
  jsonLd?: object[];
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  pageType?: string | string[];
  mainEntityId?: string;
  whatsappMessage?: string;
}

const {
  title,
  description,
  path,
  ogImage,
  ogImageAlt,
  ogType,
  ogImageWidth,
  ogImageHeight,
  jsonLd = [],
  noindex = false,
  breadcrumbs,
  pageType,
  mainEntityId,
  whatsappMessage,
} = Astro.props;

const hasBreadcrumb = Boolean(breadcrumbs && breadcrumbs.length);
const nodes: JsonLd[] = [
  organization(),
  website(),
  person(await ceoPhotoUrl()),
  // Páginas noindex (404) no publican nodo WebPage: su URL no existe como recurso canónico.
  ...(noindex ? [] : [webPage({ path, title, description, type: pageType, image: ogImage, hasBreadcrumb, mainEntityId })]),
  ...(hasBreadcrumb ? [breadcrumbList(breadcrumbs!, path)] : []),
  ...(jsonLd as JsonLd[]),
];
---

<!doctype html>
<html lang={site.lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      document.documentElement.classList.add('js');
      document.addEventListener('astro:after-swap', function () {
        document.documentElement.classList.add('js');
      });
    </script>
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <Seo
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      noindex={noindex}
      jsonLd={graph(nodes)}
    />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <ClientRouter fallback="animate" />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col bg-ink-950 text-pearl">
    <IconSprite />
    <a
      href="#contenido"
      class="fixed left-4 top-3 z-[100] -translate-y-24 rounded-full bg-gold px-5 py-3 font-semibold text-ink-950 shadow-gold transition-transform focus:translate-y-0"
    >
      Saltar al contenido
    </a>
    <Header path={path} whatsappMessage={whatsappMessage} />
    <main id="contenido" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer whatsappMessage={whatsappMessage} />
    <WhatsAppFab message={whatsappMessage} />

    <script>
      /** Scroll reveal global: añade .is-visible a [data-reveal] al entrar en viewport. */
      let observer: IntersectionObserver | undefined;

      function initReveal() {
        // Desactiva la salida de emergencia CSS (reveal-failsafe): el observer ya está activo.
        document.documentElement.classList.add('reveal-ready');
        observer?.disconnect();
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible)');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer?.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => observer!.observe(el));
      }

      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
